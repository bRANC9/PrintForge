# ---------------------------------------------------------------------------
# PrintForge – environment variables
# Copy to .env and adjust. Never commit the real .env.
#
# This file is production-first: the block below is what a TrueNAS deployment
# needs. Local-development overrides are listed as comments at the very bottom.
# Full runbook: docs/truenas-deploy.md
# ---------------------------------------------------------------------------

# ===========================================================================
# PRODUCTION (TrueNAS) — set these before the first `up`
# ===========================================================================

DJANGO_DEBUG=false

# Commit the running build was made from; reported by /api/v1/health/ and in
# the page footer. On TrueNAS the published image bakes it in, so you normally
# leave this empty. For a LOCAL `docker compose build` set it to identify the
# build: `APP_GIT_SHA=$(git rev-parse HEAD)`.
APP_GIT_SHA=

# Generate a strong key and paste it below:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated hostnames/IPs the app is served under (e.g. the NAS itself).
# Include the LAN IP you open in the browser, or the API will reject it with a
# 400 DisallowedHost (the pages still load, so the project list stays empty).
# Do NOT put a port here (that belongs in DJANGO_CSRF_TRUSTED_ORIGINS).
# Example: DJANGO_ALLOWED_HOSTS=printforge.lan,192.168.1.250,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required behind HTTPS / a reverse proxy: https://<your-domain>, comma-separated.
# Scheme + host + port of the browser origin, e.g.
#   DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.250:42069
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS / reverse-proxy hardening ---------------------------------------
# Leave these OFF (false / 0) unless TLS actually terminates in front of the app
# (reverse proxy, Cloudflare Tunnel, ...). Enabling them without HTTPS breaks
# logins and can cause a redirect loop.
# DJANGO_SECURE_SSL_REDIRECT=true       # redirect all http -> https
# DJANGO_SESSION_COOKIE_SECURE=true     # session cookie sent over https only
# DJANGO_CSRF_COOKIE_SECURE=true        # csrf cookie sent over https only
# DJANGO_SECURE_HSTS_SECONDS=31536000   # HSTS max-age (seconds); start with 3600
# DJANGO_SECURE_PROXY_SSL_HEADER=true   # trust X-Forwarded-Proto from the proxy

WEB_PORT=8080

# Image pulled by docker-compose.prod.yml (never built on the NAS).
# Pin to a tag for a rollback; Watchtower follows the image reference.
#   PRINTFORGE_IMAGE=ghcr.io/branc9/printforge:sha-1a2b3c4
#   PRINTFORGE_IMAGE=ghcr.io/branc9/printforge:1.2.0
PRINTFORGE_IMAGE=ghcr.io/branc9/printforge:latest

# Persistent data on the pool dataset (pg/, redis/, media/, ollama/).
DATA_ROOT=/mnt/<pool>/apps/printforge

# ===========================================================================
# Shared settings
# ===========================================================================

# Database (PostgreSQL + pgvector)
POSTGRES_DB=printforge
POSTGRES_USER=printforge
POSTGRES_PASSWORD=change-me
# Local dev without Docker (sqlite) is possible by setting:
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://printforge:change-me@db:5432/printforge
# Reuse DB connections for N seconds (0 disables persistent connections).
DB_CONN_MAX_AGE=60

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Gunicorn (web service) tuning. Defaults use the gthread worker class, which is
# robust for a browser UI with idle/keep-alive connections. See the
# "If gunicorn workers time out" section of docs/truenas-deploy.md.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_ACCESS_LOG=false
GUNICORN_LOG_LEVEL=info

# Ollama
# Base stack (external Ollama): set the host running Ollama. Leave it out to
# use the compose default (http://host.docker.internal:11434).
# Internal Ollama (docker-compose.ollama.yml override) forces http://ollama:11434.
# OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_MODEL=qwen3-coder:30b
# Kisebb GPU/CPU géphez: OLLAMA_MODEL=qwen2.5-coder:7b
# Optional: a vision-capable model (e.g. llava:7b, qwen2.5-vl:7b) used only by
# the agent self-check review. Empty = use the main OLLAMA_MODEL.
OLLAMA_VISION_MODEL=

# Embedding (RAG / Research agent)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
RAG_ENABLED=false

# Web search (Research agent). Empty SEARCH_BACKEND disables web search; set it
# to searxng to use the optional self-hosted instance from
# docker-compose.search.yml. SEARXNG_BASE_URL is only read when SEARCH_BACKEND
# is set, so the default below is harmless for existing deployments.
SEARCH_BACKEND=
SEARXNG_BASE_URL=http://searxng:8080

# Storage
# STORAGE_BACKEND=local keeps files on disk (MEDIA_ROOT). Set it to s3 for
# S3 / MinIO and fill in the AWS_* values below; those are ignored when local.
STORAGE_BACKEND=local
MEDIA_ROOT=/data/media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# OpenSCAD sandbox limits (see terv.md 20. fejezet)
OPENSCAD_TIMEOUT_SEC=60
OPENSCAD_MEMORY_LIMIT=1g
OPENSCAD_CPU_LIMIT=1.0

# CAD / slicing sandbox (Docker-out-of-Docker).
# The worker launches one ephemeral sandbox container per job, so it needs the
# Docker socket (mounted in the compose files) and these images must be pullable.
OPENSCAD_MODE=docker
OPENSCAD_IMAGE=ghcr.io/branc9/printforge-openscad:latest
SLICER_MODE=docker
# Per-backend sandbox images. SLICER_IMAGE is a deployment-wide override that
# wins for whichever backend is active; leave it unset to use the per-backend
# alias below.
PRUSASLICER_IMAGE=ghcr.io/branc9/printforge-prusaslicer:latest
# Optional second slicing backend (OrcaSlicer sandbox, wrapped in Xvfb). Leave
# these commented/at their defaults to keep PrusaSlicer: the base stack never
# pulls the OrcaSlicer image unless a job selects it. Switching to orca only
# needs SLICER_BACKEND; ORCASLICER_IMAGE already defaults to the published image.
# ORCASLICER_IMAGE=ghcr.io/branc9/printforge-orcaslicer:latest
# SLICER_BACKEND=prusaslicer
# SLICER_IMAGE=ghcr.io/branc9/printforge-prusaslicer:latest

# Docker-out-of-Docker scratch dir. It is bind-mounted into the worker at the
# SAME absolute path (host == container) and exported as TMPDIR, because the host
# daemon resolves the sandbox -v source paths on the host. Must be absolute.
# On TrueNAS point it at a pool dataset, e.g.
#   SANDBOX_WORK_DIR=/mnt/<pool>/apps/printforge/scratch
SANDBOX_WORK_DIR=/data/scratch

# LLM provider
# LLM_PROVIDER=ollama (default) uses OLLAMA_BASE_URL / OLLAMA_MODEL above and
# needs nothing else here. Set LLM_PROVIDER=openai to use any OpenAI-compatible
# endpoint instead (hosted OpenAI or a local gateway); only then are the values
# below read. All optional – never required.
LLM_PROVIDER=ollama
OPENAI_BASE_URL=
OPENAI_API_KEY=
# OpenRouter is OpenAI-compatible: set LLM_PROVIDER=openai and its /v1 URL above.
OPENROUTER_API_KEY=

# ===========================================================================
# LOCAL DEVELOPMENT overrides — edit these when running locally, not on the NAS
# ===========================================================================
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATA_ROOT=./data
# DATABASE_URL=sqlite:///db.sqlite3
