# ---------------------------------------------------------------------------
# PrintForge – environment variables
# Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Web
WEB_PORT=8080

# Database (PostgreSQL + pgvector)
POSTGRES_DB=printforge
POSTGRES_USER=printforge
POSTGRES_PASSWORD=change-me
# Local dev without Docker (sqlite) is possible by setting:
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://printforge:change-me@db:5432/printforge

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Ollama
# Belső Ollama override esetén: http://ollama:11434
# Külső Ollama esetén pl.:        http://192.168.1.50:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-coder:30b
# Kisebb GPU/CPU géphez: OLLAMA_MODEL=qwen2.5-coder:7b

# Embedding (RAG / Research agent)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
RAG_ENABLED=false

# Storage
STORAGE_BACKEND=local
MEDIA_ROOT=/data/media

# Where persistent data lives on the host (TrueNAS: /mnt/<pool>/apps/printforge)
DATA_ROOT=./data

# Optional cloud LLM providers (never required)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
